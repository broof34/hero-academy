{
  "name": "hero-academy",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run tests",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "check:build": "node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:games": "node scripts/build-games.mjs && node scripts/build-space.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "three": "^0.164.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
